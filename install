#!/usr/bin/env bash
#
# install all files to ~ by symlinking them,
# this way, updating them is as simple as git pull
#
# Author: Dave Eddy <dave@daveeddy.com>
# Date: May 25, 2012
# License: MIT
# Edited: November 06, 2026 by Akhil Pillai

# verbose ln, because `ln -v` is not portable
symlink() {
	printf '%55s -> %s\n' "${1/#$HOME/\~}" "${2/#$HOME/\~}"
	ln -nsf "$@"
}

git submodule init
git submodule update

# Link dotfiles
dotfiles=(
	bash_aliases
	bash_funcs
	bash_profile
	bash_termcap
	bashrc
	gitconfig
	# tmux.conf
	# vimrc
	# vim
)

for f in "${dotfiles[@]}"; do
	[[ -d ~/.$f && ! -L ~/.$f ]] && rm -r ~/."$f"
	symlink "$PWD/$f" ~/."$f"
done

# Setup bics
if [[ ! -d ~/.bics ]]; then
	echo 'installing bics'

	bics_url=https://raw.githubusercontent.com/bahamas10/bics/master/bics
	bash <(curl -sSL $bics_url) init

	rm -r ~/.bics/plugins
	symlink "$PWD/bics-plugins" ~/.bics/plugins
fi

# Setup vim (this seems to only work when the output is a terminal)
# if [[ -t 1 ]]; then
# 	set -x
# 	vim '+PlugInstall --sync' +qa
# 	vim '+PlugUpdate --sync' +qa
# 	set +x
# else
# 	echo 'you may need to run:'
# 	echo "    vim +'PlugInstall --sync' +qa"
# 	echo "    vim +'PlugUpdate --sync' +qa"
# fi

true
