#!/usr/bin/env bash
#
# install all files to ~ by symlinking them,
# this way, updating them is as simple as git pull
#
# Author: Dave Eddy <dave@daveeddy.com>
# Date: May 25, 2012
# License: MIT
# Edited: November 06, 2026 onward by Akhil Pillai

NO_FORMAT="\033[0m"
F_BOLD="\033[1m"
F_UNDERLINED="\033[4m"
C_AQUA="\033[38;5;14m"
C_LIME="\033[38;5;10m"
C_PINK="\033[38;5;13m"


if [[ "$1" == "--from-ext" ]]; then
	EXTERNAL_INSTALL=1
fi

# verbose ln, because `ln -v` is not portable
symlink() {
	printf '%55s -> %s\n' "${1/#$PWD/\.}" "${2/#$HOME/\~}"
	ln -nsf "$@"
}

prompt_ok () {
	read -r -n 1 -p "Is this ok [y/N]: " input
	if [[ ! $input =~ ^[Yy]$ ]]; then
		echo "Installation cancelled."
		exit 1
	fi
}

git submodule init
git submodule update

# Link dotfiles
dotfiles=(
	bash_aliases
	bash_funcs
	bash_profile
	bash_termcap
	bashrc
	gitconfig
	# tmux.conf
	# vimrc
	# vim
)

# Custom not-(~/.*) dotfiles
declare -a configs=(
	"fastfetch/config.jsonc"
	"foot/foot.ini"
	"hyfetch.json"
	"niri/config.kdl"
	"noctalia/settings.json"
	"starship.toml"
	"systemd/user/custom-rpc.service"
	"systemd/user/tpnoisie.service"
)

if [[ -n $EXTERNAL_INSTALL ]]; then
	echo -e "The following files will be installed to $HOME:$C_LIME"
	for f in "${dotfiles[@]}"; do
		echo "  ~/.$f"
	done
	printf "%b" "$NO_FORMAT$C_AQUA"
	for f in "${configs[@]}"; do
		echo "  ~/.config/$f"
	done
	echo -e "${NO_FORMAT}${F_BOLD}Any existing files will be overwritten.${NO_FORMAT}"

	echo -e "bics will be installed to ${F_UNDERLINED}${C_PINK}~/.bics${NO_FORMAT}, and" \
					"${F_BOLD}any existing bics plugins will be overwritten.${NO_FORMAT}"

	prompt_ok
fi

for f in "${dotfiles[@]}"; do
	[[ -d ~/.$f && ! -L ~/.$f ]] && rm -r ~/."$f"
	symlink "$PWD/$f" ~/."$f"
done

for f in "${configs[@]}"; do
	[[ -d ~/.config/$f && ! -L ~/.config/$f ]] \
		&& rm -r ~/.config/"$f"
	mkdir -p ~/.config/"$(dirname "$f")"
	symlink "$PWD/config/$f" ~/.config/"$f"
done

# Setup bics
if [[ ! -d ~/.bics ]]; then
	echo 'installing bics'

	bics_url=https://raw.githubusercontent.com/bahamas10/bics/master/bics
	bash <(curl -sSL $bics_url) init

	rm -r ~/.bics/plugins
	symlink "$PWD/bics-plugins" ~/.bics/plugins
fi

# Setup vim (this seems to only work when the output is a terminal)
# if [[ -t 1 ]]; then
# 	set -x
# 	vim '+PlugInstall --sync' +qa
# 	vim '+PlugUpdate --sync' +qa
# 	set +x
# else
# 	echo 'you may need to run:'
# 	echo "    vim +'PlugInstall --sync' +qa"
# 	echo "    vim +'PlugUpdate --sync' +qa"
# fi

true
