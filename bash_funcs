# Open an executable in PATH.
# vw <command>
vw () {
	vi $(which $1)
}

# `bat` an executable in PATH.
# Requires `bat`.
# bw <command>
bw () {
	bat $(which $1)
}

# Long-form `ls` on an executable in PATH.
# llw <command>
llw () {
	ls -l $(which $1)
}

# Read link and follow a symlinked command in PATH.
# Read Link, Follow Which
# rlfw <command>
rlfw () {
	readlink -f $(which $1)
}

# Copy last command.
# Command CoPy. Not the Chinese Communist Party.
# Requires a Wayland session. Can be modified for X.
# ccp
# ccp () {
#  	fc -ln -1 | awk '{$1=$1};1' | tr -d '\n' | wl-copy
# }
# ^ disabled, see lc and clc in aliases

# Quick checksum verification without visually comparing.
# cks <file> <hash>
cks () {
	echo "$2 $1" | sha256sum -c --quiet --status
	if [[ $? -eq 0 ]]; then
		echo "Checksum verified"
		return 0
	else
		echo "Did not match"
		return 1
	fi
}

# Overwrite a file with random data before deleting.
# rnd <size> <file>
rnd () {
	local kb="$1"
	local file="$2"
	if [[ "$file" ]]; then
		dd if=/dev/urandom of="$file" count="$kb" bs=1024
		echo "Wrote $kb KB of random data to $file"
	else
		dd if=/dev/urandom count="$kb" bs=1024
	fi
}

# Simple and usable disk usage summary.
# Check out `dua` for a more robust tool!
# dhsh [dir]
dhsh () {
	du -h --max-depth=1 ${1:-.} | sort -h
}

# Copy the contents of a file.
# Requires a Wayland session. Can be modified for X.
# fcp <file>
fcp () {
	[[ -f $1 ]] && wl-copy < $1 || echo "Invalid file"
}

# `cd` and then `ls`.
# cdls
cdls () {
	cd $1 && ls
}

# `mkdir` and then `cd` into it.
mkcd () {
	mkdir $1 && cd $1
}

# Check terminal size, then run `hyfetch`.
# Requires `hyfetch`.
# ckhyfetch
ckhyfetch () {
	if [[ $(tput cols) -ge 80 && $(tput lines) -ge 26 ]]; then
		hyfetch
	fi
}

# Open a file or URL in the preferred application.
# open <file|url>
open () {
	xdg-open "$1" &> /dev/null &
}

# Evaluate logarithms without manually opening `bc`.
# Requires `bc`.
# log [base] <number>
log () {
	local float=
	if [[ -z "$2" ]]; then
		float=$(echo "l($1)" | bc -l)
	else
		float=$(echo "l($2)/l($1)" | bc -l)
	fi
	echo "$float/1" | bc >&1
}

# Animated progress bar.
# Adapted from Dave Eddy (You Suck at Programming)
# https://www.youtube.com/watch?v=U4CzyBXyOms
# progressbar <current-step-index> <total-steps>
progressbar() {
	local current=$1

	local log_current=$(log 10 $current)
	local digits_current=$((log_current + 1))

	local len=$2

	local log_len=$(log 10 $len)
	local digits_len=$((log_len + 1))

	local padspace=$((digits_len - digits_current))

	local bar_char='>'
	local empty_char='-'

	local term_width=$(tput cols)
	# terminal width - 6 for pct.age incl. pad - 2 for bar start/end
	# - 1 for '/' - 2 * ( length of max ) - 2 for spaces
	local bar_length=$((term_width - 6 - 2 - 1 - (2 * $digits_len) -2))

	local perc_done=$((current * 100 / len))
	local pct_pad=
	if [[ $perc_done -ne 100 ]]; then
		pct_pad=' '
	fi

	local num_bars=$((perc_done * bar_length / 100))

	local i
	local s='['
	for ((i = 0; i < num_bars; i++)); do
		s+=$bar_char
	done
	for ((i = num_bars; i < bar_length; i++)); do
		s+=$empty_char
	done
	s+=']'

	local pad=''
	for ((padcount = 0; padcount < $padspace; padcount++)); do
		pad+=' '
	done

	echo -ne "\r$s $pad$current/$len $pct_pad($perc_done%)"
}
